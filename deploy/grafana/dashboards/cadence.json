{
  "uid": "cadence-overview",
  "title": "Cadence -- SLO-aware inference gateway",
  "tags": [
    "cadence"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "End-to-end latency (from arrival)",
      "description": "The SLO variable. Interpolated within Prometheus buckets -- the numbers in the README come from the load generator's raw parquet.",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, config) (rate(cadence_e2e_seconds_bucket[30s])))",
          "legendFormat": "p50 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, config) (rate(cadence_e2e_seconds_bucket[30s])))",
          "legendFormat": "p95 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, config) (rate(cadence_e2e_seconds_bucket[30s])))",
          "legendFormat": "p99 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Time to first token",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, config) (rate(cadence_ttft_seconds_bucket[30s])))",
          "legendFormat": "p50 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, config) (rate(cadence_ttft_seconds_bucket[30s])))",
          "legendFormat": "p95 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, config) (rate(cadence_ttft_seconds_bucket[30s])))",
          "legendFormat": "p99 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Inter-token latency",
      "description": "p99 ITL is where unchunked prefill shows up: a long prompt prefilled in one shot stalls every decoding sequence.",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, config) (rate(cadence_itl_seconds_bucket[30s])))",
          "legendFormat": "p50 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, config) (rate(cadence_itl_seconds_bucket[30s])))",
          "legendFormat": "p95 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, config) (rate(cadence_itl_seconds_bucket[30s])))",
          "legendFormat": "p99 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "C"
