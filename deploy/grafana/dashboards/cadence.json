        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "KV fragmentation ratio",
      "description": "allocated tokens / (allocated blocks x block size). Paged allocation should hold this above ~0.9.",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "cadence_kv_fragmentation_ratio",
          "legendFormat": "{{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Prefix cache token-level hit rate",
      "description": "Token-level, not request-level: partial hits are the normal case.",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "sum by (config) (rate(cadence_prefix_cache_hit_tokens_total[1m])) / sum by (config) (rate(cadence_prefix_cache_query_tokens_total[1m]))",
          "legendFormat": "{{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
