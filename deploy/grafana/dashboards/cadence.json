      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Engine step duration",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, config) (rate(cadence_step_seconds_bucket[30s])))",
          "legendFormat": "p50 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, config) (rate(cadence_step_seconds_bucket[30s])))",
          "legendFormat": "p99 {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "B"
