          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Queue depth and running batch size",
      "description": "Under continuous batching the running batch should be continuously changing size, not stepping between waves.",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "cadence_queue_depth",
          "legendFormat": "waiting {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        },
        {
          "expr": "cadence_batch_size",
          "legendFormat": "running {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput and goodput",
      "description": "Under overload these diverge, and goodput is the one that matters.",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (config) (rate(cadence_requests_total{state=\"done\"}[30s]))",
          "legendFormat": "throughput {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (config) (rate(cadence_slo_met_total[30s]))",
          "legendFormat": "goodput {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "B"
        },
        {
          "expr": "sum by (config) (rate(cadence_shed_total[30s]))",
          "legendFormat": "shed {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "KV blocks",
      "description": "The memory ceiling on batch size.",
      "datasource": {
        "type": "prometheus",
        "uid": "cadence-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "cadence_kv_blocks_free",
          "legendFormat": "free {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        },
        {
          "expr": "cadence_kv_blocks_total",
          "legendFormat": "total {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
