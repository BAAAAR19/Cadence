      "targets": [
        {
          "expr": "sum by (config, kind) (rate(cadence_tokens_total[30s]))",
          "legendFormat": "{{kind}} {{config}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cadence-prom"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
